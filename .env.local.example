# =========================================
# Mini Social - full environment template
# =========================================

# Runtime mode (usually set automatically by Next.js/Vercel)
# NODE_ENV=development

# ===============================
# Supabase (required)
# ===============================
# Example: https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server-only, never expose in client)
SUPABASE_SERVICE_ROLE_KEY=

# ===============================
# Stripe (required for wallet top-up)
# ===============================
# Secret API key (sk_live_... / sk_test_...)
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# One-time top-up price IDs
STRIPE_PRICE_ID_5=
STRIPE_PRICE_ID_10=
STRIPE_PRICE_ID_20=

# ===============================
# AI / Gemini (required for /api/ai and /api/ai/chat)
# ===============================
# Google AI Studio API key
GEMINI_API_KEY=
# EUR price per 1,000 tokens (numeric), example: 0.0035
PRICE_GEMINI_PER_1K=

# ===============================
# App URLs
# ===============================
# Used in Stripe checkout and callback URLs.
# Example (production): https://mini-social-mvp.vercel.app
APP_URL=
# Public site URL used by metadata/auth redirects.
# Example (production): https://mini-social-mvp.vercel.app
NEXT_PUBLIC_SITE_URL=

# ===============================
# Google OAuth (Sign in with Google)
# ===============================
# NOTE:
# These are usually configured in Supabase Dashboard -> Authentication -> Providers -> Google
# and in Google Cloud Console OAuth credentials.
# They are listed here as deployment checklist placeholders.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match allowed redirect in Supabase + Google Cloud Console.
# Recommended production callback:
# https://mini-social-mvp.vercel.app/auth/callback
GOOGLE_REDIRECT_URI=
